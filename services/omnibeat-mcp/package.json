{
  "name": "@omnibeat/mcp",
  "version": "0.1.0",
  "description": "OmniBeat MCP server - Streamable HTTP (spec 2025-11-25), :8080. Contract: @omnibeat/schemas.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",

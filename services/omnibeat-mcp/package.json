    "probe": "node scripts/probe.mjs",
    "capture-fixtures": "node scripts/capture-fixtures.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@omnibeat/schemas": "file:../../packages/schemas",
    "express": "4.21.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/express": "4.17.23",
    "@types/node": "22.10.2",
    "typescript": "5.6.3"
  }

{
  "name": "@omnibeat/phonetic-core",
  "version": "0.1.0",
  "description": "Isomorphic phonetic matching core: sound-class skeletons, Double-Metaphone-style encoding, articulatory-weighted edit distance, locale packs. Zero runtime dependencies.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./packs/*": "./packs/*"
  },
  "files": [
    "dist",
    "packs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "demo": "tsc -p tsconfig.build.json && node dist/scripts/demo.js"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "22.10.2",
    "fast-check": "3.23.1",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}

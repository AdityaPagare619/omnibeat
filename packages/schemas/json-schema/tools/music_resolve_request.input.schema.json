{
  "type": "object",
  "properties": {
    "transcript": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "description": "What the user said, as text from speech recognition."
    },
    "asr_alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      },
      "maxItems": 5,
      "description": "ASR n-best alternatives, up to 5."
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "description": "BCP-47 tag of the recogniser locale, e.g. en-IN. Optional."
    },
    "surface": {
      "type": "string",
      "enum": [
        "screenless",
        "screen",
        "tv"
      ],
      "description": "Device surface: screenless, screen, or tv."
    },
    "household_id": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque id; enables opt-in alias memory."
    },
    "profile": {
      "type": "string",
      "enum": [
        "standard",
        "kids"
      ],
      "default": "standard"
    },
    "style": {
      "type": "string",
      "enum": [
        "brief",
        "normal",
        "detailed"
      ],
      "default": "normal"
    },
    "context": {
      "type": "object",
      "properties": {
        "pending_choice": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "transcript",
    "surface"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2019-09/schema#",
  "$comment": "Generated from Zod by packages/schemas/scripts/generate-json-schema.ts — DO NOT EDIT."
